# ── Server ──────────────────────────────────────────────
PORT=3100
NODE_ENV=development
LOG_LEVEL=info

# ── Python Autonomous Core (internal only) ──────────────
PYTHON_CORE_BASE_URL=http://127.0.0.1:10000
# Dedicated gateway → Python service credential. Required in production.
PYTHON_SERVICE_TOKEN=
# Do not use browser/operator tokens here. Legacy aliases are intentionally unsupported.

# ── Redis (required for production multi-instance realtime/rate-limit authority) ──
REDIS_URL=redis://127.0.0.1:6379
REDIS_EVENT_CHANNEL=kanyoza:events
REDIS_REQUIRED=false

# Escape-hatch proxy is disabled by default and must remain disabled in production.
PROXY_ENABLED=false
IDENTITY_EXCHANGE_ENABLED=true
TRUST_PROXY=0

# ── Auth (browser → KCPG) ───────────────────────────────
JWT_SECRET=change-me-jwt-secret-min-32-chars-long
JWT_ISSUER=
JWT_AUDIENCE=kcpg
# Local UI only — never in production
AUTH_DISABLED=false

# ── CORS ────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Rate limiting ───────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ── Cache ───────────────────────────────────────────────
OVERVIEW_CACHE_TTL_MS=3000
# Prometheus-compatible scrape credential (required in production; never expose to browser)
METRICS_SCRAPE_TOKEN=

# ── Python → KCPG authenticated event bridge ────────────
# Required in production; separate from PYTHON_SERVICE_TOKEN.
PYTHON_EVENT_SIGNING_SECRET=
REQUIRE_EVENT_SIGNATURE=false
EVENT_MAX_SKEW_MS=300000

# Cookie policy: use none for a cross-site React UI; production requires Secure.
COOKIE_SAME_SITE=none
VERSION=0.6.0

# Director governed control requires the dedicated director.write scope.
CONTROL_PLANE_SCOPES=control.read,control.write,director.write,engine.read,engine.control,council.read,council.vote,workflow.read,workflow.execute,security.read,security.respond,diagnostics.read,diagnostics.execute,configuration.read

{
  "name": "kanyoza-control-plane-gateway",
  "version": "0.7.0",
  "description": "Kanyoza Control Plane Gateway (KCPG) \u2014 authoritative, durable, generation-aware command and reconciliation control plane",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "lint": "node scripts/lint.mjs",
    "test:contracts": "node --test tests/routes/health.test.js tests/routes/gateway-routes.test.js tests/contracts/workspace-activation-capability.test.js tests/contracts/github-read-allowlist.test.js tests/contracts/business-activation-confirm-command.test.js",
    "test:contract": "node --test tests/routes/gateway-routes.test.js",
    "test:chaos": "node scripts/phase65-chaos-certify.mjs",
    "test:mission": "node --test tests/phase13/final-release.test.js",
    "typecheck": "node scripts/typecheck.mjs",
    "test:authority": "node scripts/phase64-authority-certify.mjs && node scripts/phase65-chaos-certify.mjs",
    "test:phase65": "node scripts/phase65-authority-static-certify.mjs",
    "test:phase66": "node scripts/phase66-route-contract-certify.mjs",
    "test:phase67": "node scripts/phase67-route-drift-certify.mjs",
    "test:phase69": "node scripts/phase69-runtime-contract-certify.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  },
  "keywords": [
    "kanyoza",
    "gateway",
    "bff",
    "control-plane",
    "websocket"
  ],
  "license": "UNLICENSED",
  "private": true
}
